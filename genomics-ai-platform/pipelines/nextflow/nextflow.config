manifest { name = 'genomics-pgx-pipeline'; version = '0.1.0'; mainScript = 'main.nf' }

profiles {
    docker  { docker.enabled = true; docker.runOptions = '--network host' }
    test    { docker.enabled = true; docker.runOptions = '--network host' }
    // AWS Batch: needs a compute environment + queue and an S3 work dir (see infra/aws/README.md).
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = System.getenv('NXF_BATCH_QUEUE') ?: 'genomics-queue'
        workDir          = System.getenv('NXF_WORKDIR') ?: 's3://REPLACE-ME/work'
        aws.region       = 'eu-central-1'
    }
}
